# =====================================================================
# booking 预约上门服务系统 · 环境配置模板
# 安装向导会按表单自动写出 .env（本文件仅作模板，勿在生产直接改名使用）
# v1.14：新增 [oa] 组（授权验卡对接，本机联调默认指向 stub 测试桩）
# =====================================================================

[app]
# 调试开关（键名必须是 debug：Env 按「节名_键名」拼 APP_DEBUG，写 app_debug 会变成 APP_APP_DEBUG 导致永远不生效）
debug = false
default_return_type = json

[database]
hostname = 127.0.0.1
database = booking
username = root
password =
hostport = 3306
charset = utf8mb4
# 表前缀留空（schema 建表无前缀）
prefix =

[security]
# JWT 签名密钥（安装向导随机生成，泄露需立即轮换）
jwt_secret =
# JWT 有效期，单位秒，默认 7200（2 小时）
jwt_ttl = 7200
# 支付回调验签密钥（沙箱/模拟渠道 HMAC 验签，PayController 读取此键）
pay_notify_key =
# 在线支付商户密钥的加密主密钥（微信/支付宝私钥、APIv3 密钥落库前 AES-256-GCM 加密用）
# 留空时回落 jwt_secret；轮换后已存密钥需重填
pay_config_key =
# 敏感操作二次校验有效期，单位秒
sensitive_ttl = 300

[license]
# 授权码（源码版/授权版激活时填写，开源版留空）
license_key =

# --- OA 对接（授权验卡 / 发卡自检；v1.14 授权域） ---
# 本机联调指向 stub 测试桩：php -S 127.0.0.1:8090 scripts/oa-stub/index.php
# 生产改为 https://oa.example.com 并配置真实 app_id/app_secret（OA 后台-应用管理）
[oa]
base_url = http://127.0.0.1:8090
app_id = booking-test
app_secret = stub-secret-booking-test
# 发卡自检用的默认规格（/license/smoke 不传 product_spec 时取该值）
smoke_spec = year

# --- 数据备份（真实 mysqldump / 恢复） ---
# 工具绝对路径；留空则自动探测 phpstudy / 同机 MySQL 常见路径，再兜底走 PATH
[backup]
mysqldump_path =
mysql_path =
# 备份文件目录；留空用 runtime/backup
dir =

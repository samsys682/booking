# booking 管理后台环境变量示例
# 复制为 .env 后填写；.env 已被 git 忽略，禁止提交真实密钥

# ---- OA 开放平台应用凭证（仅服务端签名网关读取，禁止加 VITE_ 前缀，禁止进浏览器 bundle）----
OA_APP_ID=
OA_APP_SECRET=
OA_BASE_URL=https://oa.example.com

# ---- 支付通道开关 ----
# real = 走 /oa-pay 签名网关真实对接 OA 支付宝支付（需配置上方凭证并重启）
# mock = 本地模拟支付（未配置真实通道时用，下单 8 秒后自动确认支付）
VITE_OA_PAY=mock
